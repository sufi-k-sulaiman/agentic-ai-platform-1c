{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "date": {
      "type": "string",
      "description": "Event date"
    },
    "time": {
      "type": "string",
      "description": "Event time"
    },
    "location": {
      "type": "string",
      "description": "Event location"
    },
    "format": {
      "type": "string",
      "enum": [
        "Online",
        "In-person",
        "Hybrid"
      ],
      "description": "Event format"
    },
    "type": {
      "type": "string",
      "enum": [
        "conference",
        "workshop",
        "webinar",
        "meetup",
        "hackathon"
      ],
      "description": "Event type"
    },
    "image": {
      "type": "string",
      "description": "Event image URL"
    },
    "max_attendees": {
      "type": "number",
      "description": "Maximum number of attendees"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether event is featured"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "ongoing",
        "completed",
        "cancelled"
      ],
      "default": "upcoming",
      "description": "Event status"
    }
  },
  "required": [
    "title",
    "date",
    "location",
    "type"
  ]
}