{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "subject": {
      "type": "string",
      "description": "Subject of the message"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Read",
        "Replied",
        "Archived"
      ],
      "default": "New",
      "description": "Message status"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ]
}