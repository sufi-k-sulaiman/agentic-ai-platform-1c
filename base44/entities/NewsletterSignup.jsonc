{
  "name": "NewsletterSignup",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Subscriber email address"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "unsubscribed"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "active",
      "description": "Subscription status"
    },
    "source": {
      "type": "string",
      "description": "Where the signup came from"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or context about this subscriber (up to 1000 characters)"
    }
  },
  "required": [
    "email"
  ]
}